{
  "name": "space4x",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "tauri": "tauri",
    "tauri:build": "tauri build --no-bundle",
    "check:tauri": "cd src-tauri && cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings",
    "promote": "node tools/promote.mjs",
    "check": "node tools/remote/run.mjs node tools/ci/gate.mjs",
    "check:all": "node tools/remote/run.mjs node tools/ci/gate.mjs --all",
    "check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings 0",
    "knip": "svelte-kit sync && knip --no-progress",
    "format": "prettier --write src tests tools *.ts *.js",
    "format:check": "prettier --check src tests tools *.ts *.js",
    "test": "node tools/remote/run.mjs sh -c 'vitest run && node --test tools/ci/*.test.mjs'",
    "test:layout": "node tools/remote/run.mjs playwright test"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
