{
  "legs": ["typecheck", "lint", "knip", "format", "unit", "layout", "tauri"],
  "full": [".github/workflows/promote.yml"],
  "rules": [
    {
      "paths": [
        "**/*.md",
        ".gitignore",
        ".github/ISSUE_TEMPLATE/**",
        ".github/issue-schema.json",
        "mockup/**",
        "deploy/**",
        "launch.sh"
      ],
      "legs": []
    },
    {
      "paths": [".github/workflows/**", ".github/actions/**", "tools/ci/**"],
      "legs": ["typecheck", "lint", "knip", "format", "unit", "layout", "tauri"]
    },
    {
      "paths": [
        "tools/remote/**",
        "package.json",
        "pnpm-lock.yaml",
        "tsconfig.json",
        "vite.config.ts",
        "src/**",
        "tests/**"
      ],
      "legs": ["typecheck", "lint", "knip", "format", "unit", "layout"]
    },
    {
      "paths": ["tools/promote.mjs"],
      "legs": ["lint", "knip", "format"]
    },
    {
      "paths": ["eslint.config.js"],
      "legs": ["lint"]
    },
    {
      "paths": ["knip.json"],
      "legs": ["knip"]
    },
    {
      "paths": [".prettierrc", ".prettierignore"],
      "legs": ["format"]
    },
    {
      "paths": ["vitest.config.ts"],
      "legs": ["unit"]
    },
    {
      "paths": ["playwright.config.ts", "static/**"],
      "legs": ["layout"]
    },
    {
      "paths": ["src-tauri/**"],
      "legs": ["tauri"]
    }
  ]
}
