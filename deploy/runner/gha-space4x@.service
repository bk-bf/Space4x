[Unit]
Description=GitHub Actions runner %i for bk-bf/Space4x
After=network-online.target

[Service]
WorkingDirectory=%h/actions-runner-space4x-%i
ExecStartPre=/usr/bin/mkdir -p %h/actions-runner-space4x-%i/tmp
ExecStartPre=/usr/bin/find %h/actions-runner-space4x-%i/tmp -mindepth 1 -delete
ExecStart=%h/actions-runner-space4x-%i/run.sh
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=300
Environment=HOME=%h/actions-runner-space4x-%i/home
Environment=XDG_CACHE_HOME=%h/actions-runner-space4x-%i/home/.cache
Environment=XDG_DATA_HOME=%h/actions-runner-space4x-%i/home/.local/share
Environment=XDG_CONFIG_HOME=%h/actions-runner-space4x-%i/home/.config
Environment=TMPDIR=%h/actions-runner-space4x-%i/tmp
Environment=pnpm_config_store_dir=%h/.local/share/pnpm/store
Environment=pnpm_config_cache_dir=%h/.cache/pnpm
Environment=ACTIONS_RUNNER_HOOK_JOB_STARTED=%h/actions-runner-space4x-%i/gate.sh
Environment=PLAYWRIGHT_BROWSERS_PATH=%h/.cache/ms-playwright
MemoryHigh=8G

[Install]
WantedBy=default.target
