#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

[[ $(git symbolic-ref --short -q HEAD) == dev ]] || exit 0
if git diff --quiet && git diff --cached --quiet; then
  git merge --ff-only --quiet origin/dev 2>/dev/null || true
fi

head=$(git rev-parse HEAD)
built=$(cat build/.built-head 2>/dev/null || true)
[[ $head == "$built" ]] && exit 0

if [[ -n $built ]] && [[ -n $(git diff --name-only "$built" "$head" -- deploy install.sh 2>/dev/null) ]]; then
  exec ./install.sh
fi
./deploy/build
systemctl --user restart space4x-serve.service
